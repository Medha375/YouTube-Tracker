{
  "manifest_version": 3,
  "name": "YT Watch Report",
  "version": "0.1.0",
  "description": "Tracks what you watch on YouTube and shows a genre/creator report.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {}
}
